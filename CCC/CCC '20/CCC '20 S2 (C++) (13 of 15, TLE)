#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int m, n;
    cin >> m >> n;
    vector<vector<int>> adj(m, vector<int>(n));

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            cin >> adj[i][j];
        }
    }

    vector<vector<bool>> visited(m, vector<bool>(n, false));
    queue<pair<int, int>> q;

    visited[0][0] = true;
    q.push({0, 0});

    bool found = false;

    while (!q.empty()) {
        auto [r, c] = q.front();
        q.pop();

        if (r == m-1 && c == n-1) {
            found = true;
            break;
        } 

        long long x = adj[r][c];
        for (long long i = 1; i*i <= x; i++) {
            if (x % i != 0) continue;
            long long j = x/i;
            if (i <= m && j <= n) {
                int nr = (int)i-1;
                int nc = (int)j-1;
                if (!visited[nr][nc]) {
                    visited[nr][nc] = true;
                    q.push({nr, nc});
                }
            }
            if (i != j && j <= m && i <= n) {
                int nr = (int)j - 1;
                int nc = (int)i - 1;
                if (!visited[nr][nc]) {
                    visited[nr][nc] = true;
                    q.push({nr, nc});
                }
            }
        }
    }


    if (!found) cout << "no\n";
    else cout << "yes\n";
    
    return 0;
}
